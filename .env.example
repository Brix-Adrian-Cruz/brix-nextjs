# Copy to .env.local for local development. .env.local is gitignored.
#
# WORDPRESS_API_URL is the WPGraphQL endpoint: the WordPress URL plus
# /graphql. Set it PER ENVIRONMENT so each Next.js environment reads the
# matching WordPress environment:
#
#   Local  ->  https://dev-brix-nextjs-cms.pantheonsite.io/graphql
#   Test   ->  https://test-brix-nextjs-cms.pantheonsite.io/graphql
#   Live   ->  https://live-brix-nextjs-cms.pantheonsite.io/graphql
#
# Local reads from dev. Test and Live are set in the Pantheon Dashboard
# environment variables, not in this file.

WORDPRESS_API_URL=https://dev-brix-nextjs-cms.pantheonsite.io/graphql
